<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.eclipse.daanse</groupId>
    <artifactId>org.eclipse.daanse.rolap.itests</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>org.eclipse.daanse.rolap.itests.clearview</artifactId>
  <name>Daanse ROLAP Tests :: clearview</name>
  <description>ClearView reference-file regression corpus</description>

  <packaging>jar</packaging>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Xmx4g -Duser.language=en -Duser.country=US</argLine>
          <systemPropertyVariables>
            <daanse.test.db>duckdb</daanse.test.db>
          </systemPropertyVariables>
          <!-- Intentionally misconfigured case classes only run via EngineTestKit. -->
          <excludedGroups>failure-mode-case</excludedGroups>
          <!-- Overrides the matching junit-platform.properties keys. -->
          <properties>
            <configurationParameters>
              junit.jupiter.execution.parallel.enabled = ${daanse.test.parallel.enabled}
              junit.jupiter.execution.parallel.config.dynamic.factor = ${daanse.test.parallel.factor}
            </configurationParameters>
          </properties>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.eclipse.daanse</groupId>
      <artifactId>org.eclipse.daanse.rolap.itests.support</artifactId>
      <version>${revision}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
